{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "webfetch": "ask",
    "skill": {
      "*": "allow"
    },
    "bash": {
      "cat *.env": "deny",
      "cat .env.*": "deny"
    }
  },
  "enabled_providers": [
    "anthropic",
    "google",
    "azure",
    "opencode",
    "openai",
    "github-copilot"
  ],
  "provider": {
    "anthropic": {
      "whitelist": [
        "claude-opus-4-6",
        "claude-sonnet-4-6",
        "claude-haiku-4-6"
      ]
    },
    "google": {
      "whitelist": [
        "gemini-3.1-pro-preview",
        "gemini-3-flash-preview"
      ]
    },
    "azure": {
      "whitelist": [
        "gpt-5.3-codex",
        "gpt-5.4"
      ]
    }
  }
}
