# ==============================================================================
# Git Global Configuration
# ==============================================================================

# Default global identity (Personal profile)
[user]
	name = trungung
	email = ungkientrung@gmail.com

# Core behaviors and UI tools
[core]
	pager = delta
	excludesfile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictStyle = zdiff3

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true
	hyperlinks = true

# ==============================================================================
# Conditional Profile Overrides
# Matches repositories based on directory path to load work profiles dynamically
# ==============================================================================

# Work projects override
[includeIf "gitdir:~/code/work/"]
	path = ~/.config/git/work.gitconfig

# SCP work projects override
[includeIf "gitdir:~/code/scp/"]
	path = ~/.config/git/work.gitconfig
